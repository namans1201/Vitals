// Vitals — schema per BUILD_SPEC.md §4.
// Dates are @db.Date for day-keyed rows; timestamps are UTC (converted to
// Asia/Kolkata in application code before any calendar-date decision — see §11).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id                Int      @id @default(1)
  name              String   @default("Naman")
  dateOfBirth       DateTime @db.Date
  heightCm          Float    @default(172.7)
  sex               String   @default("male")
  timezone          String   @default("Asia/Kolkata")
  // targets — editable from the Nutrition page, never hardcoded in components
  proteinTargetG    Int      @default(125)
  calorieTargetKcal Int      @default(2450)
  fatTargetG        Int      @default(70)
  carbTargetG       Int      @default(300)
  waterTargetMl     Int      @default(4000)
  proteinPerKg      Float    @default(2.1)
  // which MealPreset.phase is "current" for quick-add — all | aug_dairy | sep_eggs
  mealPhase         String   @default("sep_eggs")
  // "HH:mm" in Asia/Kolkata — drives the "in bed by …" checklist item
  bedtimeTarget     String   @default("00:30")
  updatedAt         DateTime @updatedAt
}

/// One row per week (keyed by its Monday). Only the choices are stored —
/// the schedule itself is derived by domain/weekPlan.ts so there's a single
/// source of truth and it can never drift from the rules.
model WeekPlan {
  weekStart  DateTime @id @db.Date
  runDays    Int[] // 0 = Monday … 6 = Sunday
  offDays    Int[]
  flexChoice String   @default("run") // run | mobility
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/// The Indian-vegetarian protein table from 01-plan/02-full-programme.md §5,
/// for tap-to-add meal logging with no typing and no API calls.
///
/// proteinG/caloriesKcal/fatG/carbG are the macros for `baseAmount` units of
/// `unitLabel` (e.g. baseAmount=100, unitLabel="g" for paneer; baseAmount=1,
/// unitLabel="egg" for a whole egg) - logging a different quantity scales
/// all four linearly from this base rather than needing a per-gram row.
model FoodItem {
  id           Int     @id @default(autoincrement())
  name         String  @unique
  servingLabel String
  unitType     String  @default("gram") // gram | piece - how a typed quantity scales (continuous vs discrete)
  unitLabel    String  @default("g") // display suffix: g, ml, scoop, katori, medium, egg, white, …
  baseAmount   Float   @default(100)
  proteinG     Float
  caloriesKcal Int
  fatG         Float   @default(0)
  carbG        Float   @default(0)
  sortOrder    Int     @default(0)
  note         String?
}

model DailyLog {
  date             DateTime @id @db.Date
  // ---- manual ----
  weightKg         Float?
  waistCm          Float?
  bodyFatPct       Float?
  skeletalMuscleKg Float?
  armCm            Float?
  chestCm          Float?
  thighCm          Float?
  maxPullups       Int?
  maxPushups       Int?
  notes            String?
  waterMl          Int      @default(0)
  // Did today's planned run happen? The watch owns pace/distance/HR once the
  // Health Connect importer (Phase 2) exists — this is only the adherence
  // checkbox, mirroring how a workout set gets ticked.
  ranDone          Boolean  @default(false)
  // ---- from the watch ----
  restingHr        Int?
  sleepMinutes     Int?
  sleepStart       DateTime?
  sleepEnd         DateTime?
  deepMin          Int?
  remMin           Int?
  lightMin         Int?
  awakeMin         Int?
  steps            Int?
  activeKcal       Int?
  hrvMs            Float?
  spo2Pct          Float?
  skinTempC        Float?
  energyScore      Int?
  // ---- provenance ----
  source           String    @default("manual") // manual | healthconnect | merged
  importedAt       DateTime?

  meals       Meal[]
  workouts    Workout[]
  runs        Run[]
  checklist   ChecklistLog[]
  supplements SupplementLog[]

  @@index([date])
}

model Exercise {
  id             Int          @id @default(autoincrement())
  name           String       @unique
  muscleGroup    String // chest|back_vertical|back_horizontal|front_delt|side_delt|rear_delt|biceps|triceps|quads|hams_hinge|hams_knee|glutes|calves|core_antiext|core_antilat|core_antirot|cardio|full_body
  equipment      String // bodyweight|dumbbell|band|pullup_bar|rope|none|barbell|cable|machine|ez_bar|kettlebell|box|battle_rope|bike|rowing_machine
  isUnilateral   Boolean      @default(false)
  defaultSets    Int          @default(3)
  defaultRepsMin Int          @default(8)
  defaultRepsMax Int          @default(15)
  cues           String?
  rationale      String? // why this exercise — see 01-plan/03-exercise-rationale.md
  sets           WorkoutSet[]
}

model Workout {
  id          Int      @id @default(autoincrement())
  date        DateTime @db.Date
  sessionType String // upper_a | lower_a | upper_b | lower_b | full_body | minimum | custom
  durationMin Int?
  notes       String?
  day         DailyLog @relation(fields: [date], references: [date])
  sets        WorkoutSet[]

  @@index([date])
}

model WorkoutSet {
  id         Int      @id @default(autoincrement())
  workoutId  Int
  exerciseId Int
  setIndex   Int
  reps       Int?
  weightKg   Float?
  rir        Int? // reps in reserve
  tempo      String? // e.g. "3-1-1-0"
  completed  Boolean  @default(false)
  workout    Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercise   Exercise @relation(fields: [exerciseId], references: [id])

  @@index([workoutId])
  // The workout screen asks "every set ever logged for these exercises"
  // (see getExerciseHistories) on every render. Without this that filter is
  // a sequential scan whose cost grows with total training history.
  @@index([exerciseId])
}

model Run {
  id          Int      @id @default(autoincrement())
  date        DateTime @db.Date
  type        String // easy | intervals | long | walk_run | walk | skipping
  durationSec Int
  distanceM   Int?
  avgHr       Int?
  maxHr       Int?
  zoneSecJson Json? // {z1,z2,z3,z4,z5} seconds
  notes       String?
  source      String   @default("manual")
  day         DailyLog @relation(fields: [date], references: [date])

  @@index([date])
}

model Meal {
  id           Int      @id @default(autoincrement())
  date         DateTime @db.Date
  time         String // "13:30"
  name         String
  description  String?
  proteinG     Float    @default(0)
  caloriesKcal Int      @default(0)
  fatG         Float    @default(0)
  carbG        Float    @default(0)
  day          DailyLog @relation(fields: [date], references: [date])

  @@index([date])
}

model MealPreset {
  id           Int     @id @default(autoincrement())
  time         String
  name         String
  description  String?
  proteinG     Float
  caloriesKcal Int
  fatG         Float   @default(0)
  carbG        Float   @default(0)
  phase        String  @default("all") // all | aug_dairy | sep_eggs
  sortOrder    Int     @default(0)
}

model ChecklistItem {
  id        Int            @id @default(autoincrement())
  key       String         @unique
  label     String
  priority  Boolean        @default(false) // starred — the ones that matter most
  active    Boolean        @default(true)
  sortOrder Int            @default(0)
  logs      ChecklistLog[]
}

model ChecklistLog {
  date    DateTime      @db.Date
  itemKey String
  done    Boolean       @default(false)
  day     DailyLog      @relation(fields: [date], references: [date])
  item    ChecklistItem @relation(fields: [itemKey], references: [key])

  @@id([date, itemKey])
}

model Supplement {
  id     Int             @id @default(autoincrement())
  name   String
  dose   String
  timing String
  active Boolean         @default(true)
  status String          @default("active") // active | on_hold | stopped
  note   String?
  logs   SupplementLog[]
}

model SupplementLog {
  date         DateTime   @db.Date
  supplementId Int
  taken        Boolean    @default(false)
  day          DailyLog   @relation(fields: [date], references: [date])
  supplement   Supplement @relation(fields: [supplementId], references: [id])

  @@id([date, supplementId])
}

model BloodMarker {
  id       Int      @id @default(autoincrement())
  testDate DateTime @db.Date
  panel    String // CBC | Lipid | Liver | Kidney | Thyroid | Vitamins | Iron | Diabetes
  marker   String
  value    Float? // null means "ordered/relevant but not measured" — see `note`
  unit     String?
  refLow   Float?
  refHigh  Float?
  flag     String? // low | high | normal | borderline
  note     String?

  @@index([testDate, marker])
}

model HealthImport {
  id           Int      @id @default(autoincrement())
  importedAt   DateTime @default(now())
  sourceFile   String
  checksum     String   @unique // skip re-importing an identical file
  status       String // ok | partial | failed
  rowsIngested Int      @default(0)
  daysTouched  Int      @default(0)
  log          String? // what was parsed, what was skipped
}
