# Copy this file to .env and fill in real values. .env is gitignored.

# Local Postgres via `docker compose up -d` (see docker-compose.yml).
# In production (Neon) this must be the POOLED connection string — Neon
# dashboard → your project → Connect → check "Pooled connection". The app's
# runtime PrismaClient (src/lib/db.ts) always reads this var, so it needs to
# tolerate many short-lived serverless connections.
DATABASE_URL="postgresql://vitals:vitals@localhost:5433/vitals?schema=public"

# Only needed in production against Neon. Prisma Migrate (`prisma migrate
# deploy`, run by the Prisma CLI via prisma7.config.ts) needs a DIRECT
# (unpooled) connection — pgbouncer's pooling mode doesn't support the
# session-level locks Migrate uses. Neon dashboard → your project → Connect
# → uncheck "Pooled connection" to get this string. Leave unset locally;
# prisma7.config.ts falls back to DATABASE_URL when it's absent.
# DIRECT_URL="postgresql://user:pass@ep-xxxx.region.aws.neon.tech/vitals?sslmode=require"

# The single login password for this app. Anyone with this password gets
# full access — there is no per-user auth. Pick something you don't reuse
# elsewhere.
APP_PASSWORD="change-me"

# Random secret used to sign the session cookie (HMAC). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me"

# Bearer token the PowerShell sync script (§7.4.3) presents to POST /api/import.
# Only needed once Phase 4 (automation) is wired up.
IMPORT_BEARER_TOKEN="change-me"
