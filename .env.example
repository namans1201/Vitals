# Copy this file to .env and fill in real values. .env is gitignored.

# Local Postgres via `docker compose up -d` (see docker-compose.yml).
DATABASE_URL="postgresql://vitals:vitals@localhost:5433/vitals?schema=public"

# The single login password for this app. Anyone with this password gets
# full access — there is no per-user auth. Pick something you don't reuse
# elsewhere.
APP_PASSWORD="change-me"

# Random secret used to sign the session cookie (HMAC). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me"

# Bearer token the PowerShell sync script (§7.4.3) presents to POST /api/import.
# Only needed once Phase 4 (automation) is wired up.
IMPORT_BEARER_TOKEN="change-me"
